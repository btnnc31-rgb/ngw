# Server
PORT=4000
NODE_ENV=development

# Database
DB_PATH=./data/minigent.db

# Agent Configuration
AGENT_POLL_INTERVAL_MS=30000
AGENT_MAX_CONCURRENT=10
AGENT_COOLDOWN_MS=5000

