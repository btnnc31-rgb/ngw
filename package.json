{
  "name": "ngw-minigent",
  "version": "1.0.0",
  "description": "AI Mini-Agent System - Autonomous agents that monitor social groups, detect opportunities, and close deals",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/unit",
    "lint": "eslint src/ --ext .js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "agents:status": "node src/cli/status.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "better-sqlite3": "^11.0.0",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "eventemitter3": "^5.0.1",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "keywords": [
    "ai-agents",
    "social-monitoring",
    "deal-automation",
    "mini-agents",
    "opportunity-detection"
  ],
  "license": "MIT"
}
